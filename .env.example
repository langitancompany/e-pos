# Salin file ini menjadi `.env.local` lalu isi nilainya:
#   cp .env.example .env.local
# JANGAN commit `.env.local` atau mengisi nilai rahasia di file ini.

# ── Supabase (WAJIB) ───────────────────────────────────────────────────────
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase service role (server only) ────────────────────────────────────
# Dipakai untuk "Tambah/Ubah/Hapus User" di Pengaturan Admin dan untuk
# webhook Midtrans. JANGAN pernah diberi awalan NEXT_PUBLIC_ (bocor ke browser).
SUPABASE_SERVICE_ROLE_KEY=

# ── Midtrans (OPSIONAL — hanya untuk pembayaran QRIS/online) ───────────────
# Kalau kosong, fitur Midtrans menampilkan "belum dikonfigurasi".
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = production, selain itu = sandbox
MIDTRANS_IS_PRODUCTION=false
# Awalan order ID (huruf/angka/-_.~, maks 12 karakter). Default: POS
MIDTRANS_ORDER_PREFIX=POS
# Masa berlaku pembayaran dalam menit (1–1440). Default: 30
MIDTRANS_EXPIRY_MINUTES=30
