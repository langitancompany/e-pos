diff -ruN a/app/components/ui/Button.tsx b/app/components/ui/Button.tsx
--- a/app/components/ui/Button.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/app/components/ui/Button.tsx	2026-11-03 11:03:16.808126889 +0000
@@ -0,0 +1,77 @@
+"use client";
+
+// ── TAMBAHAN (komponen UI bersama) ── Tombol seragam. Sebelumnya ada puluhan
+// variasi class tombol (hijau, bergaris, merah) yang ditulis ulang di tiap
+// modul. Sekarang cukup pilih `variant` dan `size`.
+//
+// Cara pakai (props <button> biasa tetap berlaku: onClick, disabled, type, dst.):
+//   <Button variant="primary" onClick={save}>Simpan</Button>
+//   <Button variant="secondary" size="sm" onClick={close}>Batal</Button>
+//   <Button variant="danger" fullWidth disabled={saving}>Hapus</Button>
+//
+// Catatan: `type` TIDAK diberi nilai bawaan (sama seperti <button> biasa,
+// bawaan browser = "submit"), jadi tombol submit di dalam <form> tetap bekerja.
+// Tombol non-submit tetap perlu type="button" seperti sebelumnya.
+//
+// Props:
+//   variant   "primary" (hijau, aksi utama) | "secondary" (bergaris, aksi
+//             sekunder/batal) | "danger" (merah, aksi merusak) | "ghost"
+//             (tanpa latar, aksi ringan).
+//   size      "sm" | "md" (default) | "lg".
+//   fullWidth true -> w-full.
+//   className hanya untuk margin/posisi (mis. "mt-5", "flex-1").
+
+import { forwardRef, type ButtonHTMLAttributes } from "react";
+
+export type ButtonVariant = "primary" | "secondary" | "danger" | "ghost";
+export type ButtonSize = "sm" | "md" | "lg";
+
+const VARIANT_CLASS: Record<ButtonVariant, string> = {
+  primary: "bg-lco-green text-white hover:bg-lco-green-hover",
+  secondary:
+    "border border-zinc-300 text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-900",
+  danger: "bg-lco-coral text-white hover:bg-lco-coral/90",
+  ghost:
+    "text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900",
+};
+
+const SIZE_CLASS: Record<ButtonSize, string> = {
+  sm: "px-3 py-1.5 text-xs",
+  md: "px-3.5 py-2 text-sm",
+  lg: "px-4 py-2.5 text-sm",
+};
+
+const BASE_CLASS =
+  "inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors duration-150 disabled:cursor-not-allowed disabled:opacity-60";
+
+interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
+  variant?: ButtonVariant;
+  size?: ButtonSize;
+  fullWidth?: boolean;
+}
+
+const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button(
+  {
+    variant = "primary",
+    size = "md",
+    fullWidth = false,
+    className = "",
+    children,
+    ...rest
+  },
+  ref,
+) {
+  return (
+    <button
+      ref={ref}
+      className={`${BASE_CLASS} ${VARIANT_CLASS[variant]} ${SIZE_CLASS[size]} ${
+        fullWidth ? "w-full" : ""
+      } ${className}`.trim()}
+      {...rest}
+    >
+      {children}
+    </button>
+  );
+});
+
+export default Button;
diff -ruN a/app/components/ui/Input.tsx b/app/components/ui/Input.tsx
--- a/app/components/ui/Input.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/app/components/ui/Input.tsx	2026-11-03 11:03:16.811473374 +0000
@@ -0,0 +1,52 @@
+"use client";
+
+// ── TAMBAHAN (komponen UI bersama) ── Kolom isian teks seragam (text, number,
+// date, tel, email, search, password). Tinggi dan gayanya sama persis dengan
+// <Select>, jadi sejajar rapi di toolbar/form. Sebelumnya tiap file punya
+// konstanta `inputClass` sendiri (18 definisi berbeda).
+//
+// Cara pakai (props <input> biasa tetap berlaku):
+//   <Input value={name} onChange={(e) => setName(e.target.value)} placeholder="Nama" />
+//   <Input size="lg" type="date" />
+//
+// Props:
+//   size      "md" (default, toolbar/filter) | "lg" (form).
+//   fullWidth default TRUE (kolom isian hampir selalu selebar kontainernya);
+//             beri fullWidth={false} untuk lebar mengikuti isi.
+//   className tambahan khusus (mis. "pl-9" untuk ikon, "font-mono tabular-nums").
+//
+// Untuk checkbox/radio/file/color tetap pakai <input> biasa.
+
+import { forwardRef, type InputHTMLAttributes } from "react";
+
+export type InputSize = "md" | "lg";
+
+const SIZE_CLASS: Record<InputSize, string> = {
+  md: "px-3 py-2 text-sm",
+  lg: "px-3 py-2.5 text-sm",
+};
+
+const BASE_CLASS =
+  "rounded-md border border-zinc-300 bg-white text-zinc-900 outline-none transition-colors duration-150 placeholder:text-zinc-400 focus:border-lco-teal focus:ring-2 focus:ring-lco-teal/20 disabled:cursor-not-allowed disabled:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:disabled:bg-zinc-800";
+
+interface InputProps extends Omit<InputHTMLAttributes<HTMLInputElement>, "size"> {
+  size?: InputSize;
+  fullWidth?: boolean;
+}
+
+const Input = forwardRef<HTMLInputElement, InputProps>(function Input(
+  { size = "md", fullWidth = true, className = "", ...rest },
+  ref,
+) {
+  return (
+    <input
+      ref={ref}
+      className={`${BASE_CLASS} ${SIZE_CLASS[size]} ${
+        fullWidth ? "w-full" : ""
+      } ${className}`.trim()}
+      {...rest}
+    />
+  );
+});
+
+export default Input;
diff -ruN a/app/components/ui/Modal.tsx b/app/components/ui/Modal.tsx
--- a/app/components/ui/Modal.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/app/components/ui/Modal.tsx	2026-11-03 11:03:16.814787759 +0000
@@ -0,0 +1,134 @@
+"use client";
+
+// ── TAMBAHAN (komponen UI bersama) ── Kerangka dialog/modal seragam: lapisan
+// gelap di belakang + kartu putih di tengah. Sebelumnya pasangan <div> overlay
+// + <div> kartu ini disalin ke 20+ tempat dengan opasitas, bayangan, dan
+// batas tinggi yang berbeda-beda.
+//
+// Modal hanya mengurus KERANGKA. Isi (judul, form, tombol) tetap ditulis di
+// dalamnya; untuk judul + tombol tutup standar ada <ModalHeader>.
+//
+// Cara pakai:
+//   <Modal size="md" aria-label="Batalkan catatan kas">
+//     <ModalHeader title="Batalkan Catatan Kas" onClose={onClose} />
+//     ...isi...
+//   </Modal>
+//
+// Props:
+//   size      "sm" | "md" | "lg" | "xl" | "2xl" — lebar maksimum kartu.
+//   padding   "lg" (p-6, default) | "md" (p-5) | "none" (isi mengatur sendiri,
+//             mis. header/footer bergaris).
+//   layout    "scroll" (default: isi memanjang -> kartu bisa digulir)
+//             | "flex" (kolom flex; area isi sendiri yang digulir, untuk header
+//               + isi + footer tetap) | "clip" | "plain".
+//   onBackdropClick  opsional — dipanggil kalau area gelap di luar kartu
+//             diklik. SENGAJA tidak aktif bawaan supaya form yang sedang diisi
+//             tidak tertutup tidak sengaja.
+//   Props div lain (aria-label, id, dst.) diteruskan ke kartu.
+
+import type { HTMLAttributes, ReactNode } from "react";
+import { X } from "lucide-react";
+
+export type ModalSize = "sm" | "md" | "lg" | "xl" | "2xl";
+
+const SIZE_CLASS: Record<ModalSize, string> = {
+  sm: "max-w-sm",
+  md: "max-w-md",
+  lg: "max-w-lg",
+  xl: "max-w-xl",
+  "2xl": "max-w-2xl",
+};
+
+const PADDING_CLASS = {
+  none: "",
+  md: "p-5",
+  lg: "p-6",
+} as const;
+
+const LAYOUT_CLASS = {
+  scroll: "max-h-[90vh] overflow-y-auto",
+  flex: "flex max-h-[90vh] flex-col overflow-hidden",
+  clip: "overflow-hidden",
+  plain: "",
+} as const;
+
+interface ModalProps extends HTMLAttributes<HTMLDivElement> {
+  size?: ModalSize;
+  padding?: keyof typeof PADDING_CLASS;
+  layout?: keyof typeof LAYOUT_CLASS;
+  onBackdropClick?: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({
+  size = "md",
+  padding = "lg",
+  layout = "scroll",
+  onBackdropClick,
+  className = "",
+  children,
+  ...rest
+}: ModalProps) {
+  return (
+    <div
+      className="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/40 p-4"
+      onMouseDown={
+        onBackdropClick
+          ? (e) => {
+              if (e.target === e.currentTarget) onBackdropClick();
+            }
+          : undefined
+      }
+    >
+      <div
+        role="dialog"
+        aria-modal="true"
+        className={`w-full ${SIZE_CLASS[size]} rounded-xl border border-zinc-200 bg-white shadow-xl dark:border-zinc-800 dark:bg-zinc-950 ${PADDING_CLASS[padding]} ${LAYOUT_CLASS[layout]} ${className}`
+          .replace(/\s+/g, " ")
+          .trim()}
+        {...rest}
+      >
+        {children}
+      </div>
+    </div>
+  );
+}
+
+interface ModalHeaderProps {
+  title: ReactNode;
+  /** Ikon kecil di kiri judul, mis. <Lock className="h-4 w-4 text-lco-coral" />. */
+  icon?: ReactNode;
+  /** Kalau diisi, tombol tutup (X) muncul di kanan. */
+  onClose?: () => void;
+  /** Menonaktifkan tombol tutup (mis. saat sedang menyimpan). */
+  closeDisabled?: boolean;
+  className?: string;
+}
+
+export function ModalHeader({
+  title,
+  icon,
+  onClose,
+  closeDisabled = false,
+  className = "mb-4",
+}: ModalHeaderProps) {
+  return (
+    <div className={`flex items-center justify-between gap-3 ${className}`}>
+      <h3 className="flex items-center gap-2 text-base font-semibold">
+        {icon}
+        {title}
+      </h3>
+      {onClose && (
+        <button
+          type="button"
+          onClick={onClose}
+          disabled={closeDisabled}
+          aria-label="Tutup"
+          className="text-zinc-400 transition-colors duration-150 hover:text-zinc-600 disabled:opacity-50 dark:hover:text-zinc-200"
+        >
+          <X className="h-4 w-4" />
+        </button>
+      )}
+    </div>
+  );
+}
